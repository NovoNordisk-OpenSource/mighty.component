#' @title Add rows via non-domain-named param
#' @description
#' Adds new rows, but the dataset parameter is deliberately not called `domain`
#' to test that a marker on a non-domain parameter is rejected.
#' @param dataset `character` Name of new dataset being created
#' @param label `character` Label for the newly added rows
#' @type row
#' @origin Derived
#' @method Rows added for a fixed test category
#' @depends {{{dataset}}} LBTEST
#' @outputs LBTEST
#' @code
new_rows <- {{{dataset}}} |>
  dplyr::filter(LBTEST == "Microcytes") |>
  dplyr::mutate(LBTEST = "{{{label}}}")

{{{dataset}}} <- rbind({{{dataset}}}, new_rows)
