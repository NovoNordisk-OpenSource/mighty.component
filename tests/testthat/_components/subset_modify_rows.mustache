#' @title Modify rows
#' @description
#' Modifies existing rows in place without changing row count.
#' @param domain `character` Name of new domain being created
#' @type row
#' @origin Derived
#' @method Rows modified for a fixed test category
#' @depends {{{domain}}} LBTEST
#' @outputs LBTEST
#' @code
{{{domain}}} <- {{{domain}}} |>
  dplyr::mutate(LBTEST = paste0(LBTEST, " (modified)"))
